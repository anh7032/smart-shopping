# Sao chép file này thành ".env" rồi điền giá trị thật từ Supabase Dashboard
# (Project Settings > API > Project URL / anon public key).
# Biến phải có tiền tố EXPO_PUBLIC_ để Expo nhúng vào bundle app.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
